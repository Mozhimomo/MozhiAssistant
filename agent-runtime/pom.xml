<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mozhi</groupId>
        <artifactId>mozhi-assistant-parent</artifactId>
        <version>0.1.4</version>
    </parent>

    <artifactId>mozhi-agent-runtime</artifactId>

    <properties>
        <lombok.version>1.18.48</lombok.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fs.starfarer</groupId>
            <artifactId>starfarer-api</artifactId>
            <version>0.98a-RC5</version>
            <scope>system</scope>
            <systemPath>${starsector.core}/starfarer.api.jar</systemPath>
        </dependency>

        <!-- 战役距离 API 引用的向量类型由游戏提供，禁止合并进运行包。 -->
        <dependency>
            <groupId>org.lwjgl.lwjgl</groupId>
            <artifactId>lwjgl_util</artifactId>
            <version>2.9.3</version>
            <scope>system</scope>
            <systemPath>${starsector.core}/lwjgl_util.jar</systemPath>
        </dependency>

        <!-- 桥接接口只能有一个定义，由游戏的引导加载器提供。 -->
        <dependency>
            <groupId>com.mozhi</groupId>
            <artifactId>mozhi-bootstrap</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>


        <!-- 所有服务商配置和调用均位于可复用的基础设施模块中。 -->
        <dependency>
            <groupId>com.mozhi</groupId>
            <artifactId>mozhi-llm-client</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>agent-runtime</finalName>
        <plugins>
            <!-- 显式注册 Lombok，兼容 JDK 23 及以上不再自动扫描注解处理器的编译行为。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-private-runtime</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${mozhi.skipDeployment}</skip>
                            <target>
                                <mkdir dir="${maven.multiModuleProjectDirectory}/jars"/>
                                <copy file="${maven.multiModuleProjectDirectory}/llm-client/target/mozhi-llm-client-${project.version}-all.jar"
                                      tofile="${maven.multiModuleProjectDirectory}/jars/mozhi-llm-client.jar"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${maven.multiModuleProjectDirectory}/jars/agent-runtime.jar"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
