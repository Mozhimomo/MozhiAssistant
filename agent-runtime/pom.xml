<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mozhi</groupId>
        <artifactId>mozhi-assistant-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>mozhi-agent-runtime</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.fs.starfarer</groupId>
            <artifactId>starfarer-api</artifactId>
            <version>0.98a-RC5</version>
            <scope>system</scope>
            <systemPath>${starsector.core}/starfarer.api.jar</systemPath>
        </dependency>

        <!-- Game-owned vector types referenced by campaign distance APIs; never shade them. -->
        <dependency>
            <groupId>org.lwjgl.lwjgl</groupId>
            <artifactId>lwjgl_util</artifactId>
            <version>2.9.3</version>
            <scope>system</scope>
            <systemPath>${starsector.core}/lwjgl_util.jar</systemPath>
        </dependency>

        <!-- The bridge has ONE definition, supplied by the game's bootstrap loader. -->
        <dependency>
            <groupId>com.mozhi</groupId>
            <artifactId>mozhi-bootstrap</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>


        <!-- All provider configuration and calls live in the reusable infrastructure module. -->
        <dependency>
            <groupId>com.mozhi</groupId>
            <artifactId>mozhi-llm-client</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.48</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>agent-runtime</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-private-runtime</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${mozhi.skipDeployment}</skip>
                            <target>
                                <mkdir dir="${maven.multiModuleProjectDirectory}/jars"/>
                                <copy file="${maven.multiModuleProjectDirectory}/llm-client/target/mozhi-llm-client-${project.version}-all.jar"
                                      tofile="${maven.multiModuleProjectDirectory}/jars/mozhi-llm-client.jar"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${maven.multiModuleProjectDirectory}/jars/agent-runtime.jar"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>