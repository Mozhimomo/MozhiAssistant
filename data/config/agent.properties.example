# 使用 UTF-8 保存。发行包的 agent.properties 由此模板生成；填写服务地址、模型和密钥后使用。
# apiKey 直接填写真实密钥；或写成 ${MOZHI_API_KEY} 读取指定环境变量。
baseUrl=https://api.openai.com/v1/
modelName=YOUR_TOOL_CAPABLE_MODEL
apiKey=
timeoutSeconds=60

# 可选参数留空时使用服务端默认值。
temperature=
topP=
maxTokens=
maxCompletionTokens=
presencePenalty=
frequencyPenalty=
seed=

maxRetries=0
memoryMaxMessages=64
maxSequentialToolsInvocations=4
systemPrompt=你是游戏《远行星号》中的墨汁智能体。简短地用中文回答。涉及玩家舰队时必须调用 getFleetSummary 实时读取最新详情，不要凭记忆猜测。涉及整数加法时必须调用 add 工具。调用完工具后向用户解释结果。

# ReAct 上下文窗口：按序列化 UTF-8 字节保守估算 token，包含工具定义和用户画像。
contextWindowTokens=262144
# 留空则按 maxTokens/maxCompletionTokens 预留；两者也为空时为 4096。
contextReserveTokens=32768
compressionTriggerRatio=0.8
compressionKeepRecentTurns=4
# 提示词中的摘要目标长度（UTF-8 字节），仅作引导；模型返回正文完整保留，不截取。
compressionSummaryTokens=2048
# 摘要请求生成预算（含思考），独立于保存长度；留空默认最高 8192，随小窗口缩小。
summaryMaxOutputTokens=
# 相对 agent.properties 所在目录；默认所有存档共享一份用户画像。
longTermMemoryFile=../memory/user-profile.json

# 游戏聊天启用流式回复；服务不支持流式时可设为 false。
streamingEnabled=true

# 类型化 AI Service 输出：prompt 由框架自动生成格式提示；json_schema 使用服务端 Schema 约束。
# 默认 prompt 兼容更多接口；仅在模型服务明确支持 JSON Schema 时使用 json_schema。
# 普通聊天和工具调用不因此强制改为 JSON 输出。
structuredOutputMode=prompt

# 舰队 Agent 默认每 15 秒（不含暂停时间）异步重新规划，失败时也会触发。
# Monitor 只检查执行结果；旧版 fleetReview* / fleetStallDays / fleetMaxReplans 已不使用。
# 舰队规划器可独立覆盖聊天的输出与思考配置；省略键时继承聊天配置。
# 输出预算包含思考和计划正文；思考参数默认继承聊天配置。
fleetPlannerMaxOutputTokens=32768

# 思考模式（对话与摘要互相独立；留空则不发送参数，不互相继承）。
# thinkingMode / summaryThinkingMode: enabled 或 disabled；用于 DeepSeek thinking.type 协议。
# reasoningEffort / summaryReasoningEffort: none/minimal/low/medium/high/xhigh/max，具体支持范围由服务商决定。
# DeepSeek 常用 low/high/max，none 关闭思考；disabled 不可搭配开启思考的 effort。
# 开启思考时，maxTokens/maxCompletionTokens 同时需要容纳思考与正文。
# DeepSeek 建议摘要 disabled + none，避免摘要预算被思考消耗。
thinkingMode=
reasoningEffort=
summaryThinkingMode=
summaryReasoningEffort=
