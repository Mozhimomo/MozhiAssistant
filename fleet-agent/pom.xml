<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <parent><groupId>com.mozhi</groupId><artifactId>mozhi-assistant-parent</artifactId><version>0.1.1</version></parent>
 <artifactId>mozhi-fleet-agent</artifactId>
 <dependencies>
  <dependency><groupId>com.mozhi</groupId><artifactId>mozhi-llm-client</artifactId><version>${project.version}</version></dependency>
  <dependency><groupId>com.mozhi</groupId><artifactId>mozhi-bootstrap</artifactId><version>${project.version}</version><scope>provided</scope></dependency>
  <dependency><groupId>com.fs.starfarer</groupId><artifactId>starfarer-api</artifactId><version>0.98a-RC5</version><scope>system</scope><systemPath>${starsector.core}/starfarer.api.jar</systemPath></dependency>
  <!-- CargoAPI does not expose fractional commodity accounting; read CargoData's public accessor. -->
  <dependency><groupId>com.fs.starfarer</groupId><artifactId>starfarer-core</artifactId><version>0.98a-RC5</version><scope>system</scope><systemPath>${starsector.core}/starfarer_obf.jar</systemPath></dependency>
  <dependency><groupId>com.fs.starfarer</groupId><artifactId>fs-common</artifactId><version>0.98a-RC5</version><scope>system</scope><systemPath>${starsector.core}/fs.common_obf.jar</systemPath></dependency>
  <dependency><groupId>org.lwjgl.lwjgl</groupId><artifactId>lwjgl_util</artifactId><version>2.9.3</version><scope>system</scope><systemPath>${starsector.core}/lwjgl_util.jar</systemPath></dependency>
 </dependencies>
 <build><finalName>fleet-agent</finalName><plugins>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId>
   <executions><execution><id>copy-fleet-agent</id><phase>package</phase><goals><goal>run</goal></goals>
    <configuration><skip>${mozhi.skipDeployment}</skip><target>
     <mkdir dir="${maven.multiModuleProjectDirectory}/jars"/>
     <copy file="${project.build.directory}/fleet-agent.jar" tofile="${maven.multiModuleProjectDirectory}/jars/fleet-agent.jar"/>
    </target></configuration>
   </execution></executions>
  </plugin>
 </plugins></build>
</project>
