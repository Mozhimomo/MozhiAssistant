**/target/
/.mvn/repository/
/.mvn/verification-settings.xml
# Keep game libraries out; ship bootstrap, chat agent, fleet agent and shared LLM runtime JARs.
/jars/*.jar
!/jars/mozhi-bootstrap.jar
!/jars/agent-runtime.jar
!/jars/mozhi-llm-client.jar
!/jars/fleet-agent.jar
/lib/
**/.idea/
*.iml
/data/config/agent.properties
/data/memory/
/dist/
