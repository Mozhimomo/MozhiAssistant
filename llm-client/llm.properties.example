# UTF-8；没有任何游戏或 agent 专用配置。复制后填写自己的端点、模型和密钥。
baseUrl=https://api.openai.com/v1/
modelName=YOUR_TOOL_CAPABLE_MODEL
apiKey=${MOZHI_API_KEY}
timeoutSeconds=60
streamingEnabled=true
maxRetries=0
maxTokens=4096
maxCompletionTokens=
temperature=
topP=
presencePenalty=
frequencyPenalty=
seed=
# 仅在服务支持时填写。留空不传；两种思考参数的支持范围取决于服务端。
thinkingMode=
reasoningEffort=
